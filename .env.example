# Server Configuration (Render — Backend)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection (Render — Backend — NEVER expose to frontend)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/hoh_tickets_db?retryWrites=true&w=majority

# Security Secrets (Render — Backend — NEVER expose to frontend)
JWT_SECRET=your_secure_random_jwt_secret_key_here
ADMIN_EMAIL=admin@houseofhumour.com
ADMIN_PASSWORD=your_secure_admin_password_here

# CORS Allowed Origin (Render — Backend)
FRONTEND_URL=https://hoh-ticket-portal.vercel.app

# Frontend Environment Variable (set in Vercel for production)
VITE_API_URL=https://hoh-ticket-portal.onrender.com

